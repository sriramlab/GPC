# Ignore Python cache files
__pycache__/
*.pyc

# Ignore VS Code settings
.vscode/

# Ignore environment folders
venv/
.env

# Ignore files
*.npz
*.bz2
*.h5
*.jpc
*.vcf
*PADDED.hapt

results/1KG/8020/wgan/output_dir
results/1KG/aats/wgan/output_dir
results/1KG/afr/wgan/output_dir
results/1KG/noneur/wgan/output_dir
results/b38/8020/wgan/output_dir

results/UKBB
aux/UKBB*
aux/chr*

pc/demo/data/500000_train.txt

aux/b38*

impute5/results

results/b38
aux/b38_real_eur.hapt
aux/b38_real_noneur.hapt

*indices*
# Run logs from the review experiments (kept locally)
logs/
pc/logs/

# Demo output: regenerated by pc/demo/train_demo.py
pc/demo/out/

# Editor and LaTeX build artifacts
*.bak
*.bak[0-9]
*~
texput.log
overleaf/*.aux
overleaf/*.out
overleaf/*.blg
overleaf/*.log

# Benchmark scratch: only the final grid is tracked
benchmarks/results/*
!benchmarks/results/final/
!benchmarks/results/final/**

# Per-chunk imputation intermediates: reassembled into the tracked results
*_dosages.npy
*_dosages.npy.chunk*.npy

# Raw sample matrices are regenerated from the checkpoints; only the compressed
# VCFs are tracked, since those are what the Impute5 pipeline consumes.
results/**/*samples*.hapt
results/**/*samples*.txt

# Manuscript workspace and review response: kept local, not published
overleaf/

# Private review material: reviewer comments and unsubmitted manuscript PDFs
GPC comments.docx
gpc_iclr_2026.pdf

# Local-only: superseded diagnostics and PyJuice debugging aids
archive/
